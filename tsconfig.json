{
 "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["DOM","ES2022"],
    "moduleResolution": "Node16",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "outDir": "dev",
    "types": ["vitest/globals", "node"],
  },
  "include": ["src/**/*", "test/**/*"]
}
